---
// GridOverlay.astro - Interactive grid system
---

<div class="grid-overlay" id="grid-overlay">
  <div class="grid-header">
    <div class="grid-logo">⚡ GRID</div>
    <div class="grid-stats">
      <span class="nodes">24</span>
      <span class="active">ACTIVE</span>
    </div>
    <button class="close-btn" id="close-grid">&times;</button>
  </div>
  
  <div class="grid-container">
    <div class="grid-items">
      <!-- Dynamic grid items will be generated by JavaScript -->
    </div>
  </div>
  
  <div class="grid-controls">
    <button class="grid-btn" id="grid-sync">🎵 SYNC</button>
    <button class="grid-btn" id="grid-chaos">⚡ CHAOS</button>
    <button class="grid-btn" id="grid-zen">🧘 ZEN</button>
  </div>
</div>

<style>
.grid-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.95);
  backdrop-filter: blur(15px);
  z-index: 50;
  display: none;
  flex-direction: column;
  padding: 20px;
  color: white;
}

.grid-overlay.active {
  display: flex;
}

.grid-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
  padding: 0 10px;
}

.grid-logo {
  font-size: 24px;
  font-weight: bold;
  background: linear-gradient(45deg, #ff6b35, #f7931e);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.grid-stats {
  display: flex;
  gap: 10px;
  font-size: 14px;
}

.nodes {
  background: rgba(255, 107, 53, 0.2);
  padding: 4px 8px;
  border-radius: 12px;
  border: 1px solid #ff6b35;
}

.active {
  background: rgba(46, 213, 115, 0.2);
  padding: 4px 8px;
  border-radius: 12px;
  border: 1px solid #2ed573;
}

.close-btn {
  background: none;
  border: none;
  color: white;
  font-size: 30px;
  cursor: pointer;
  padding: 0;
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: background 0.3s ease;
}

.close-btn:hover {
  background: rgba(255, 255, 255, 0.1);
}

.grid-container {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 20px 0;
}

.grid-items {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  grid-template-rows: repeat(6, 1fr);
  gap: 8px;
  width: min(80vw, 300px);
  height: min(80vw, 300px);
  padding: 20px;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20px;
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.grid-item {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 8px;
  border: 1px solid rgba(255, 255, 255, 0.2);
  transition: all 0.3s ease;
  cursor: pointer;
  position: relative;
  overflow: hidden;
}

.grid-item:hover {
  background: rgba(255, 107, 53, 0.3);
  border-color: #ff6b35;
  transform: scale(1.05);
}

.grid-item.active {
  background: linear-gradient(45deg, #ff6b35, #f7931e);
  border-color: #ff6b35;
  box-shadow: 0 0 20px rgba(255, 107, 53, 0.5);
}

.grid-item.active::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 6px;
  height: 6px;
  background: white;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.grid-controls {
  display: flex;
  justify-content: center;
  gap: 15px;
  margin-top: 20px;
}

.grid-btn {
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.2);
  color: white;
  padding: 12px 20px;
  border-radius: 25px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  backdrop-filter: blur(10px);
}

.grid-btn:hover {
  background: rgba(255, 107, 53, 0.3);
  border-color: #ff6b35;
  transform: translateY(-2px);
}

.grid-btn:active {
  transform: translateY(0);
}

@media (max-width: 480px) {
  .grid-overlay {
    padding: 15px;
  }
  
  .grid-items {
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(4, 1fr);
    width: min(85vw, 280px);
    height: min(85vw, 280px);
  }
  
  .grid-controls {
    flex-direction: column;
    gap: 10px;
  }
  
  .grid-btn {
    padding: 15px 20px;
    font-size: 16px;
  }
}
</style>

<script>
class GridOverlay {
  private overlay: HTMLElement | null = null;
  private gridItems: HTMLElement | null = null;
  private gridPattern: boolean[][] = [];
  private isActive = false;
  private beatInterval: NodeJS.Timeout | null = null;

  constructor() {
    this.overlay = document.getElementById('grid-overlay') as HTMLElement;
    if (!this.overlay) return;
    
    this.gridItems = this.overlay.querySelector('.grid-items') as HTMLElement;
    this.init();
  }

  init() {
    this.generateGrid();
    this.setupEventListeners();
    this.startBeatSync();
  }

  generateGrid() {
    if (!this.gridItems) return;
    
    const isMobile = window.innerWidth <= 480;
    const gridSize = isMobile ? 4 : 6;
    
    // Initialize pattern
    this.gridPattern = Array(gridSize).fill(null).map(() => Array(gridSize).fill(false));
    
    // Clear existing items
    this.gridItems.innerHTML = '';
    
    // Create grid items
    for (let i = 0; i < gridSize * gridSize; i++) {
      const item = document.createElement('div');
      item.className = 'grid-item';
      item.dataset.index = i.toString();
      
      item.addEventListener('click', () => {
        const row = Math.floor(i / gridSize);
        const col = i % gridSize;
        this.toggleGridItem(row, col);
      });
      
      this.gridItems.appendChild(item);
    }
  }

  toggleGridItem(row: number, col: number) {
    this.gridPattern[row][col] = !this.gridPattern[row][col];
    this.updateGridDisplay();
    
    // Trigger audio event
    window.dispatchEvent(new CustomEvent('grid-trigger', {
      detail: { row, col, active: this.gridPattern[row][col] }
    }));
  }

  updateGridDisplay() {
    if (!this.gridItems) return;
    
    const items = this.gridItems.querySelectorAll('.grid-item');
    const gridSize = Math.sqrt(items.length);
    
    items.forEach((item, index) => {
      const row = Math.floor(index / gridSize);
      const col = index % gridSize;
      
      if (this.gridPattern[row] && this.gridPattern[row][col]) {
        item.classList.add('active');
      } else {
        item.classList.remove('active');
      }
    });
  }

  setupEventListeners() {
    // Close button
    document.getElementById('close-grid')?.addEventListener('click', () => {
      this.hide();
    });
    
    // Grid control buttons
    document.getElementById('grid-sync')?.addEventListener('click', () => {
      this.syncMode();
    });
    
    document.getElementById('grid-chaos')?.addEventListener('click', () => {
      this.chaosMode();
    });
    
    document.getElementById('grid-zen')?.addEventListener('click', () => {
      this.zenMode();
    });

    // Global beat events
    window.addEventListener('beat', (e: Event) => {
      if (this.isActive && (e as CustomEvent).detail) {
        this.onBeat((e as CustomEvent).detail);
      }
    });

    // Close on background click
    this.overlay?.addEventListener('click', (e) => {
      if (e.target === this.overlay) {
        this.hide();
      }
    });
  }

  syncMode() {
    // Create synchronized pattern
    const gridSize = this.gridPattern.length;
    for (let i = 0; i < gridSize; i++) {
      for (let j = 0; j < gridSize; j++) {
        this.gridPattern[i][j] = (i + j) % 2 === 0;
      }
    }
    this.updateGridDisplay();
  }

  chaosMode() {
    // Random pattern
    const gridSize = this.gridPattern.length;
    for (let i = 0; i < gridSize; i++) {
      for (let j = 0; j < gridSize; j++) {
        this.gridPattern[i][j] = Math.random() > 0.7;
      }
    }
    this.updateGridDisplay();
  }

  zenMode() {
    // Clear all
    const gridSize = this.gridPattern.length;
    for (let i = 0; i < gridSize; i++) {
      for (let j = 0; j < gridSize; j++) {
        this.gridPattern[i][j] = false;
      }
    }
    this.updateGridDisplay();
  }

  onBeat(beatData: any) {
    if (!this.gridItems) return;
    
    // Flash active grid items on beat
    const activeItems = this.gridItems.querySelectorAll('.grid-item.active');
    activeItems.forEach(item => {
      (item as HTMLElement).style.boxShadow = '0 0 30px rgba(255, 107, 53, 0.8)';
      setTimeout(() => {
        (item as HTMLElement).style.boxShadow = '0 0 20px rgba(255, 107, 53, 0.5)';
      }, 100);
    });
  }

  startBeatSync() {
    // Sync with beat system
    this.beatInterval = setInterval(() => {
      if (this.isActive) {
        this.onBeat({ strength: 0.8 });
      }
    }, 500);
  }

  show() {
    this.isActive = true;
    this.overlay?.classList.add('active');
    this.generateGrid(); // Regenerate for current screen size
  }

  hide() {
    this.isActive = false;
    this.overlay?.classList.remove('active');
  }

  toggle() {
    if (this.isActive) {
      this.hide();
    } else {
      this.show();
    }
  }
}

// Initialize when DOM is ready
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', () => {
    (window as any).gridOverlay = new GridOverlay();
  });
} else {
  (window as any).gridOverlay = new GridOverlay();
}

// Make toggle function available globally
(window as any).toggleGrid = () => {
  (window as any).gridOverlay?.toggle();
};
</script>
