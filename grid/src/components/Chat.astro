---
// src/components/Chat.astro - Clean Bottom Chat
const initialMessages = [
  { text: "⭐ Legendary vibes", type: 'normal' },
  { text: "⚫ This black aesthetic is fire!", type: 'normal' },
  { text: "📺 Floating player is sick!", type: 'normal' },
];
---

<div class="chat-container">
  <div class="chat-header">
    <span class="chat-title">Legendary Chat</span>
    <span class="chat-viewers">
      <span id="chat-viewer-count">1,247</span> viewers
    </span>
  </div>
  
  <div class="chat-messages" id="chat-messages">
    {initialMessages.map(msg => (
      <div class={`message ${msg.type}`}>
        {msg.text}
      </div>
    ))}
  </div>
  
  <div class="chat-input-area">
    <button class="sparkle-btn" aria-label="Effects">✨</button>
    <input 
      type="text" 
      class="chat-input" 
      id="chat-input" 
      placeholder="Type something legendary..."
      maxlength="100"
      autocomplete="off"
      autocorrect="off"
    />
    <button class="send-btn" id="send-btn" aria-label="Send">
      ▶
    </button>
  </div>
</div>

<script>
  import { appStore } from '../scripts/stores/appStore';

  const messagesContainer = document.getElementById('chat-messages');
  const input = document.getElementById('chat-input') as HTMLInputElement;
  const sendBtn = document.getElementById('send-btn');

  const randomMessages = [
    "🔥 This beat is fire!",
    "🎧 Sound Factory vibes",
    "💯 Best stream ever",
    "🌟 Legendary!",
    "🚀 To the moon!",
    "⚡ Electric energy",
    "🎵 Track ID?",
    "🔊 Turn it up!",
    "✨ Magic happening"
  ];

  function addMessage(text: string, type: string = 'normal') {
    if (!messagesContainer) return;
    
    const messageEl = document.createElement('div');
    messageEl.className = `message ${type} new`;
    messageEl.textContent = text;
    
    messagesContainer.appendChild(messageEl);
    messagesContainer.scrollTop = messagesContainer.scrollHeight;
    
    // Keep only last 10 messages
    while (messagesContainer.children.length > 10) {
      messagesContainer.removeChild(messagesContainer.firstChild!);
    }
  }

  function sendMessage() {
    const text = input.value.trim();
    if (text) {
      addMessage(text, 'user');
      input.value = '';
      
      if ('vibrate' in navigator) {
        navigator.vibrate(10);
      }
    }
  }

  sendBtn?.addEventListener('click', sendMessage);
  
  input?.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      sendMessage();
    }
  });

  // Auto messages
  setInterval(() => {
    const randomIndex = Math.floor(Math.random() * randomMessages.length);
    addMessage(randomMessages[randomIndex]);
  }, 4000 + Math.random() * 4000);

  // Update viewer count
  appStore.subscribe((state) => {
    const viewerElement = document.getElementById('chat-viewer-count');
    if (viewerElement && state.viewerCount) {
      viewerElement.textContent = state.viewerCount.toLocaleString();
    }
  });
</script>

<style>
  .chat-container {
    background: rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    display: flex;
    flex-direction: column;
    height: 100%;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .chat-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .chat-title {
    font-size: 14px;
    font-weight: 600;
    color: white;
  }

  .chat-viewers {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.6);
  }

  .chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 8px 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    -webkit-overflow-scrolling: touch;
  }

  .message {
    background: rgba(255, 255, 255, 0.1);
    padding: 6px 12px;
    border-radius: 16px;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.9);
    max-width: 80%;
    word-wrap: break-word;
    width: fit-content;
  }

  .message.user {
    align-self: flex-end;
    background: var(--color-accent);
    color: black;
  }

  .message.new {
    animation: slideIn 0.3s ease;
  }

  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .chat-input-area {
    display: flex;
    gap: 8px;
    padding: 8px 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(0, 0, 0, 0.5);
  }

  .sparkle-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    border: none;
    color: white;
    font-size: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
  }

  .chat-input {
    flex: 1;
    background: rgba(255, 255, 255, 0.1);
    border: none;
    border-radius: 20px;
    padding: 8px 16px;
    color: white;
    font-size: 14px;
    outline: none;
  }

  .chat-input::placeholder {
    color: rgba(255, 255, 255, 0.5);
  }

  .send-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--color-accent);
    border: none;
    color: black;
    font-size: 16px;
    font-weight: bold;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
  }

  .send-btn:active {
    transform: scale(0.9);
  }

  /* Hide scrollbar */
  .chat-messages::-webkit-scrollbar {
    display: none;
  }

  /* Mobile optimizations */
  @media (max-width: 375px) {
    .chat-header {
      padding: 6px 12px;
    }
    
    .message {
      font-size: 13px;
      padding: 5px 10px;
    }
    
    .chat-input {
      font-size: 13px;
    }
  }
</style>
