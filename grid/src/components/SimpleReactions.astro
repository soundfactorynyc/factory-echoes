---
// Simple Reactions component for testing
---

<div class="simple-reactions">
  <h3>Reactions Component</h3>
  <div class="reaction-buttons">
    <button class="simple-btn">❤️</button>
    <button class="simple-btn">🔥</button>
    <button class="simple-btn">😂</button>
    <button class="simple-btn">🎉</button>
  </div>
</div>

<style>
  .simple-reactions {
    padding: 20px;
    background: rgba(255,255,255,0.1);
    border-radius: 10px;
    margin: 10px 0;
  }
  
  .simple-reactions h3 {
    color: white;
    text-align: center;
  }
  
  .reaction-buttons {
    display: flex;
    gap: 10px;
    justify-content: center;
  }
  
  .simple-btn {
    background: none;
    border: 1px solid white;
    border-radius: 50%;
    width: 50px;
    height: 50px;
    font-size: 24px;
    cursor: pointer;
  }
</style>
