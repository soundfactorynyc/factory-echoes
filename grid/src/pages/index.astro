---
// Import your Grid OS components
import App from '../App';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Grid OS - Interactive Grid System</title>
		<style>
			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}

			body {
				font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
				background: #0a0a0a;
				color: #ffffff;
				overflow-x: hidden;
			}

			.grid-container {
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				z-index: 1;
				opacity: 0.7;
			}

			.content-layer {
				position: relative;
				z-index: 10;
				min-height: 100vh;
				display: grid;
				grid-template-columns: repeat(12, 1fr);
				gap: 20px;
				padding: 40px;
				max-width: 1400px;
				margin: 0 auto;
			}

			.hero-section {
				grid-column: 2 / 12;
				text-align: center;
				padding: 100px 0;
			}

			h1 {
				font-size: 4rem;
				font-weight: 900;
				margin-bottom: 20px;
				background: linear-gradient(135deg, #60a5fa, #3b82f6);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				animation: glow 2s ease-in-out infinite alternate;
			}

			@keyframes glow {
				from { filter: drop-shadow(0 0 20px rgba(96, 165, 250, 0.5)); }
				to { filter: drop-shadow(0 0 30px rgba(59, 130, 246, 0.8)); }
			}

			.tagline {
				font-size: 1.5rem;
				color: #94a3b8;
				margin-bottom: 40px;
			}

			.nav-grid {
				grid-column: 1 / -1;
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 20px;
				margin-bottom: 60px;
			}

			.grid-card {
				background: rgba(30, 41, 59, 0.5);
				backdrop-filter: blur(10px);
				border: 1px solid rgba(96, 165, 250, 0.3);
				border-radius: 8px;
				padding: 30px;
				text-align: center;
				transition: all 0.3s ease;
				cursor: pointer;
				text-decoration: none;
				color: white;
			}

			.grid-card:hover {
				transform: translateY(-5px);
				border-color: #60a5fa;
				background: rgba(30, 41, 59, 0.8);
				box-shadow: 0 10px 30px rgba(96, 165, 250, 0.3);
			}

			.grid-card h3 {
				font-size: 1.25rem;
				margin-bottom: 10px;
				color: #60a5fa;
			}

			.grid-card p {
				color: #cbd5e1;
				font-size: 0.9rem;
			}

			.status-bar {
				position: fixed;
				bottom: 0;
				left: 0;
				right: 0;
				background: rgba(15, 23, 42, 0.9);
				backdrop-filter: blur(10px);
				padding: 20px;
				z-index: 20;
				display: flex;
				justify-content: space-between;
				align-items: center;
				border-top: 1px solid rgba(96, 165, 250, 0.3);
			}

			.status-indicator {
				display: flex;
				align-items: center;
				gap: 10px;
			}

			.status-dot {
				width: 8px;
				height: 8px;
				background: #10b981;
				border-radius: 50%;
				animation: pulse 2s infinite;
			}

			@keyframes pulse {
				0%, 100% { opacity: 1; }
				50% { opacity: 0.5; }
			}

			.console-hint {
				color: #64748b;
				font-size: 0.875rem;
			}

			@media (max-width: 768px) {
				.content-layer {
					grid-template-columns: 1fr;
					padding: 20px;
				}

				.hero-section {
					grid-column: 1;
					padding: 50px 0;
				}

				h1 {
					font-size: 2.5rem;
				}

				.nav-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<!-- Grid Background -->
		<div class="grid-container">
			<App client:load />
		</div>

		<!-- Content Layer -->
		<div class="content-layer">
			<section class="hero-section">
				<h1>Grid OS</h1>
				<p class="tagline">An Interactive Grid-Based Operating System</p>
			</section>

			<nav class="nav-grid">
				<a href="/grid-component-test.html" class="grid-card">
					<h3>Component Test</h3>
					<p>Test individual grid components and interactions</p>
				</a>
				<a href="/grid-visual-test.html" class="grid-card">
					<h3>Visual Test</h3>
					<p>Explore visual grid demonstrations</p>
				</a>
				<a href="/grid-integration-test.html" class="grid-card">
					<h3>Integration Test</h3>
					<p>Full system integration testing</p>
				</a>
				<a href="/test" class="grid-card">
					<h3>Documentation</h3>
					<p>Learn about Grid OS architecture</p>
				</a>
			</nav>
		</div>

		<!-- Status Bar -->
		<div class="status-bar">
			<div class="status-indicator">
				<span class="status-dot"></span>
				<span>Grid OS Active</span>
			</div>
			<div class="console-hint">
				Press F12 and run: window.gridOS.getSystemHealth()
			</div>
		</div>

		<script>
			// Import Grid OS initialization
			import '../index';
			
			// Log initialization
			console.log('Grid OS Homepage initialized');
			
			// Add some interactivity
			document.querySelectorAll('.grid-card').forEach(card => {
				card.addEventListener('mouseenter', () => {
					// You could trigger grid animations here
					if (window.gridOS) {
						console.log('Card hover detected');
					}
				});
			});
			
			// Add a test button for system health
			setTimeout(() => {
				console.log('🔍 Testing Grid OS system health...');
				if (window.gridOS) {
					try {
						const health = window.gridOS.getSystemHealth();
						console.log('💊 System Health:', health);
						
						// Test shader system specifically
						if (window.gridOS.isShaderSystemReady) {
							console.log('🎨 Shader System Ready:', window.gridOS.isShaderSystemReady());
						}
						
						// Test shader system methods
						if (window.gridOS.getShaderSystem) {
							const shaderSystem = window.gridOS.getShaderSystem();
							console.log('🔧 Shader System:', {
								isReady: shaderSystem.isReady(),
								dimensions: shaderSystem.getDimensions(),
								activeShaders: Array.from(shaderSystem.activeShaders.keys())
							});
						}
					} catch (error) {
						console.error('❌ Error testing system:', error);
					}
				} else {
					console.warn('⚠️ window.gridOS not available');
				}
			}, 2000);
		</script>
	</body>
</html>